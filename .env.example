# Copia este archivo como .env y rellena los valores. .env NUNCA se sube a Git.
# Las credenciales de Odoo, Telegram y Google se guardan en las credenciales de n8n, no aquí.

# Usado por el script de evaluación (tests/)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Odoo (usado por scripts/probar_odoo.js). En n8n, estos datos van en la credencial de Odoo.
ODOO_URL=https://tu-base.odoo.com
ODOO_DB=tu-base
ODOO_USER=tu-correo@ejemplo.com
ODOO_API_KEY=

# Telegram (usado por scripts/telegram_chat_id.js). En n8n, el token va en la credencial de Telegram.
TELEGRAM_BOT_TOKEN=
